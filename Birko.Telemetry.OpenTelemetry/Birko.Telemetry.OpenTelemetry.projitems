<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a7b8c9d0-e1f2-4a3b-8c5d-6e7f8a9b0c1d</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Telemetry.OpenTelemetry</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)BirkoOpenTelemetryOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenTelemetryServiceExtensions.cs" />
  </ItemGroup>
</Project>
