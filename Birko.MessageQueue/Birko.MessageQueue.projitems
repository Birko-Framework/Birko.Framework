<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>c4d5e6f7-a8b9-4c0d-9e1f-2a3b4c5d6e70</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.MessageQueue</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <Compile Include="$(MSBuildThisFileDirectory)Core\IMessageQueue.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\IMessageProducer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\IMessageConsumer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\IMessageHandler.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\ISubscription.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\QueueMessage.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\MessageHeaders.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\MessageContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\ConsumerOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\MessageAckMode.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\MessageFingerprint.cs" />
    <!-- Patterns -->
    <Compile Include="$(MSBuildThisFileDirectory)Patterns\IPublisher.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Patterns\ISubscriber.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Patterns\ISender.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Patterns\IReceiver.cs" />
    <!-- Serialization -->
    <Compile Include="$(MSBuildThisFileDirectory)Serialization\IMessageSerializer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Serialization\JsonMessageSerializer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Serialization\EncryptingMessageSerializer.cs" />
    <!-- Retry -->
    <Compile Include="$(MSBuildThisFileDirectory)Retry\DeadLetterOptions.cs" />
    <!-- Transactions -->
    <Compile Include="$(MSBuildThisFileDirectory)Transactions\ITransactionalProducer.cs" />
  </ItemGroup>
</Project>
