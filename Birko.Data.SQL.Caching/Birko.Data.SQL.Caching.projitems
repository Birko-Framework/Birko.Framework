<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>c3d4e5f6-1a2b-4c5d-6e7f-8a9b0c1d2e3f</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.SQL.Caching</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Caching\SqlCacheKeyBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Caching\SqlCacheOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Stores\CachedAsyncDataBaseBulkStore.cs" />
  </ItemGroup>
</Project>
