<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a2b3c4d5-e6f7-4a8b-9c0d-1e2f3a4b5c6d</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Localization</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <Compile Include="$(MSBuildThisFileDirectory)Core\MissingKeyBehavior.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\LocalizationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\ITranslationProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\ICultureResolver.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\ILocalizer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\IPluralizer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\INumberFormatter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\IDateFormatter.cs" />
    <!-- Formatting -->
    <Compile Include="$(MSBuildThisFileDirectory)Formatting\StringInterpolator.cs" />
    <!-- Providers -->
    <Compile Include="$(MSBuildThisFileDirectory)Providers\Localizer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Providers\ThreadCultureResolver.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Providers\CldrPluralizer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Providers\NumberFormatter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Providers\DateFormatter.cs" />
    <!-- Translation -->
    <Compile Include="$(MSBuildThisFileDirectory)Translation\InMemoryTranslationProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Translation\JsonTranslationProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Translation\ResxTranslationProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Translation\CompositeTranslationProvider.cs" />
  </ItemGroup>
</Project>
