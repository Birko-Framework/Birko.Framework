<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>c4d5e6f7-a8b9-4c0d-9e1f-b038bcca5101</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.EventBus.Outbox.SQL</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Models -->
    <Compile Include="$(MSBuildThisFileDirectory)Models\OutboxEntryModel.cs" />
    <!-- Core -->
    <Compile Include="$(MSBuildThisFileDirectory)SqlOutboxStore.cs" />
  </ItemGroup>
</Project>
