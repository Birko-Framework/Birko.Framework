<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>ecf79379-f127-4618-8001-41481398215c</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Communication.gRPC</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Two forms, one dependency. Under Central Package Management a PackageReference must NOT
         carry a Version (NU1008) — the consumer's Directory.Packages.props owns it. Conditioning on
         the well-known $(ManagePackageVersionsCentrally) serves both.

         This project wraps Grpc.Net.Client and owns it. Birko.Communication.gRPC.Server declares
         Grpc.AspNetCore instead — a different package for the server half, so the two never collide
         even where both are imported (TASK-234). -->
    <PackageReference Include="Grpc.Net.Client" Version="2.*" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="Grpc.Net.Client" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GrpcSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GrpcChannelPool.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GrpcClientFactory.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GrpcAuthenticationInterceptor.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GrpcException.cs" />
  </ItemGroup>
</Project>
