<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>d3e4f5a6-b7c8-4d9e-a0f1-2b3c4d5e6f7a</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Health</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <Compile Include="$(MSBuildThisFileDirectory)Core\IHealthCheck.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\HealthCheckResult.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\HealthStatus.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\HealthCheckRegistration.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\HealthReport.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\HealthCheckRunner.cs" />
    <!-- System -->
    <Compile Include="$(MSBuildThisFileDirectory)System\DiskSpaceHealthCheck.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)System\MemoryHealthCheck.cs" />
  </ItemGroup>
</Project>
