<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>fe1321bc-49f6-4656-917d-6ee3505257b9</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Security.OAuth.Server.InMemory</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Stores\InMemoryOAuthStores.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Extensions\OAuthServerInMemoryServiceCollectionExtensions.cs" />
  </ItemGroup>
</Project>
