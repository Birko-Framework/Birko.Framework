<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a1b2c3d4-e5f6-4a7b-8c9d-tag000000001</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.Tagging</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Models -->
    <Compile Include="$(MSBuildThisFileDirectory)Models\ITaggable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Models\Tag.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Models\EntityTag.cs" />
    <!-- Services -->
    <Compile Include="$(MSBuildThisFileDirectory)Services\ITagService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Services\TagService.cs" />
    <!-- Extensions -->
    <Compile Include="$(MSBuildThisFileDirectory)Extensions\TaggingExtensions.cs" />
  </ItemGroup>
</Project>
