<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{C1D2E3F4-A5B6-4C7D-8E9F-1A2B3C4D5E6F}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.Migrations.ElasticSearch</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: Nest (package NEST), declared by Birko.Data.ElasticSearch.projitems and
       deliberately NOT repeated here. A consumer imports this projitems alongside that one — this
       project extends the ElasticSearch store and cannot work without it — so a second declaration
       lands in the same project file and restore reports NU1504, which the -warnaserror that
       verify-conventions runs turns into an error. Import Birko.Data.ElasticSearch.projitems to get
       the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)ElasticSearchMigrationStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ElasticSearchMigrationRunner.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Settings\ElasticSearchMigrationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\ElasticSearchMigrationContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\ElasticSearchSchemaBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\ElasticSearchDataMigrator.cs" />
  </ItemGroup>
</Project>
