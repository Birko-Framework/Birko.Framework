<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{B8C4D5E6-1A3F-4B9C-7D2E-8F4A1B6C9E3D}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.Migrations.SQL</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)SqlMigrationStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SqlMigrationRunner.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)CreateTablesMigration.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SqlScriptMigration.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Settings\SqlMigrationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\SqlMigrationContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\SqlSchemaBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\SqlDataMigrator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\SchemaField.cs" />
  </ItemGroup>
</Project>
