    <Compile Include="$(MSBuildThisFileDirectory)GraphQLSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)IGraphQLClient.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GraphQLSubscription.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GraphQLRequestBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GraphQLClient.cs" />
  </ItemGroup>
</Project>
