<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>50a6df4a-3138-4b59-9845-f2bb44560001</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.RavenDB.Views</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: RavenDB.Client, declared by Birko.Data.RavenDB.projitems and deliberately NOT
       repeated here. A consumer imports this projitems alongside that one — this project builds on the RavenDB store and cannot work without it — so a
       second declaration lands in the same project file and restore reports NU1504, which the
       -warnaserror that verify-conventions runs turns into an error. Import Birko.Data.RavenDB.projitems to
       get the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)RavenViewTranslator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RavenViewStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RavenViewManager.cs" />
  </ItemGroup>
</Project>
