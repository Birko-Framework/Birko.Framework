<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── ToolTip — dark chip, token-driven ─────────────────────────────── -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource BTooltipBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BTooltipTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BTooltipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="MaxWidth" Value="{DynamicResource BTooltipMaxWidth}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ── Dropdown menu surface (MenuFlyout) ────────────────────────────── -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource BBgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadius}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ── Dropdown menu item (flat menus; submenus reuse Fluent) ─────────── -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="root" Background="Transparent"
                CornerRadius="{DynamicResource BRadiusSm}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#root">
      <Setter Property="Background" Value="{DynamicResource BRowHoverBgBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#root">
      <Setter Property="Background" Value="{DynamicResource BRowHoverBgBrush}" />
    </Style>
  </ControlTheme>

  <!-- Breadcrumb (Controls/Breadcrumb.cs) is a ContentControl that builds its crumbs in code;
       it renders via the default ContentControl theme, so it needs no ControlTheme here. -->

</ResourceDictionary>
