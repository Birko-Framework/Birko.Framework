<!--
  Birko restyled ControlThemes (STORY-031 gate, expanded by STORY-034). Every visual value comes
  from a design token via {DynamicResource B*}, so controls re-theme live on RequestedThemeVariant.
  This file just merges the per-category dictionaries; merge it (via BirkoTheme.axaml) AFTER the
  Fluent base theme.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Birko.Xaml.Avalonia/Controls/Buttons.axaml" />
    <ResourceInclude Source="avares://Birko.Xaml.Avalonia/Controls/Inputs.axaml" />
    <ResourceInclude Source="avares://Birko.Xaml.Avalonia/Controls/Toggles.axaml" />
    <ResourceInclude Source="avares://Birko.Xaml.Avalonia/Controls/Surfaces.axaml" />
    <ResourceInclude Source="avares://Birko.Xaml.Avalonia/Controls/Indicators.axaml" />
    <ResourceInclude Source="avares://Birko.Xaml.Avalonia/Controls/Overlays.axaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
