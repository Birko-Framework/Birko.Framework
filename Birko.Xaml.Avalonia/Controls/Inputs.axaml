<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── TextBox — surface + border + focus ring (single-line & multiline) ── -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource BBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="MinHeight" Value="{DynamicResource BControlMinHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Foreground inherits from the TextBox (TextElement.Foreground). -->
          <TextPresenter x:Name="PART_TextPresenter"
                         Text="{TemplateBinding Text, Mode=TwoWay}"
                         Margin="{TemplateBinding Padding}"
                         TextWrapping="{TemplateBinding TextWrapping}"
                         TextAlignment="{TemplateBinding TextAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderHoverBrush}" />
    </Style>
    <Style Selector="^:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderFocusBrush}" />
    </Style>
    <!-- Multiline (textarea): top-align text and grow. -->
    <Style Selector="^[AcceptsReturn=True]">
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="80" />
    </Style>
  </ControlTheme>

  <!-- ── ComboBox (select) — box + chevron + token-styled popup ─────────── -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="MinHeight" Value="{DynamicResource BControlMinHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <Border x:Name="box" Grid.ColumnSpan="2"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <ContentControl Grid.Column="0" Margin="{TemplateBinding Padding}"
                          Content="{TemplateBinding SelectionBoxItem}"
                          Foreground="{TemplateBinding Foreground}"
                          VerticalAlignment="Center" />
          <Path Grid.Column="1" Width="10" Height="6" Margin="0,0,10,0"
                VerticalAlignment="Center" Stretch="Uniform"
                Data="M0,0 L5,5 L10,0" Fill="{DynamicResource BTextSecondaryBrush}" />
          <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 IsLightDismissEnabled="True"
                 PlacementMode="Bottom" PlacementTarget="{TemplateBinding}">
            <Border Background="{DynamicResource BBgElevatedBrush}"
                    BorderBrush="{DynamicResource BBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource BRadius}"
                    Padding="4" Margin="0,4,0,0" MinWidth="{Binding $parent[ComboBox].Bounds.Width}">
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#box">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderHoverBrush}" />
    </Style>
    <Style Selector="^:focus /template/ Border#box">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderFocusBrush}" />
    </Style>
  </ControlTheme>

  <!-- ── ComboBoxItem — dropdown row with hover/selected states ─────────── -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="row" Background="Transparent"
                CornerRadius="{DynamicResource BRadiusSm}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#row">
      <Setter Property="Background" Value="{DynamicResource BRowHoverBgBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#row">
      <Setter Property="Background" Value="{DynamicResource BColorPrimaryLightBrush}" />
    </Style>
  </ControlTheme>

  <!-- ── Slider — token-driven, horizontal + vertical (EPIC-016/TASK-054) ──
       Track lays out DecreaseButton (the filled portion) | Thumb | IncreaseButton (transparent, so the
       rail shows through). Cross-axis thickness + alignment are set per orientation via pseudo-class
       styles on the named parts, so one template serves both. -->
  <ControlTheme x:Key="BSliderRepeat" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource BRadiusFull}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="BSliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="16" Height="16" CornerRadius="{DynamicResource BRadiusFull}"
                Background="{DynamicResource BInputThumbBgBrush}"
                BorderBrush="{DynamicResource BColorPrimaryBrush}" BorderThickness="2" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BColorPrimaryHoverBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="Background" Value="{DynamicResource BBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BColorPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="rail" Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource BRadiusFull}" />
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource BSliderRepeat}"
                            Background="{TemplateBinding Foreground}" />
            </Track.DecreaseButton>
            <Thumb Theme="{StaticResource BSliderThumb}" />
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource BSliderRepeat}"
                            Background="Transparent" />
            </Track.IncreaseButton>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Horizontal: thin centered rail/fill, thumb rides the middle. -->
    <Style Selector="^:horizontal">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="^:horizontal /template/ Border#rail">
      <Setter Property="Height" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:horizontal /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Height" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:horizontal /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Height" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Vertical: thin centered rail/fill down the column (equalizer). -->
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="24" />
    </Style>
    <Style Selector="^:vertical /template/ Border#rail">
      <Setter Property="Width" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:vertical /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Width" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:vertical /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Width" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource BDisabledOpacity}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
