<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Birko.Xaml.Avalonia.Controls"
                    xmlns:cmd="clr-namespace:Birko.Xaml.Core.Commands;assembly=Birko.Xaml.Core">

  <!-- ── Drawer — slide-in overlay panel ───────────────────────────────── -->
  <ControlTheme x:Key="{x:Type c:Drawer}" TargetType="c:Drawer">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Backdrop" Background="{DynamicResource BBackdropBgBrush}" />
          <Border x:Name="PART_Panel"
                  Width="{DynamicResource BDrawerWidth}"
                  HorizontalAlignment="Right"
                  Background="{DynamicResource BBgElevatedBrush}"
                  BorderBrush="{DynamicResource BBorderBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="20">
            <ContentPresenter Content="{TemplateBinding Content}"
                              Foreground="{DynamicResource BTextBrush}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:left /template/ Border#PART_Panel">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
  </ControlTheme>

  <!-- ── CommandPalette — searchable command overlay (Ctrl+K style) ─────── -->
  <ControlTheme x:Key="{x:Type c:CommandPalette}" TargetType="c:CommandPalette">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Backdrop" Background="{DynamicResource BBackdropBgBrush}" />
          <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,88,0,0"
                  Background="{DynamicResource BBgElevatedBrush}"
                  BorderBrush="{DynamicResource BBorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource BRadiusLg}">
            <DockPanel>
              <TextBox x:Name="PART_SearchBox" DockPanel.Dock="Top" Margin="8"
                       Watermark="Type a command…"
                       Text="{TemplateBinding SearchText, Mode=TwoWay}" />
              <ListBox x:Name="PART_List" Margin="8,0,8,8" MaxHeight="320"
                       ItemsSource="{TemplateBinding FilteredCommands}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="cmd:CommandItem">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource BTextBrush}" />
                      <TextBlock Text="{Binding Group}" FontSize="{DynamicResource BTextXs}"
                                 Foreground="{DynamicResource BTextMutedBrush}"
                                 IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- ── Modal — centered dialog over a backdrop ───────────────────────── -->
  <ControlTheme x:Key="{x:Type c:Modal}" TargetType="c:Modal">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Backdrop" Background="{DynamicResource BBackdropBgBrush}" />
          <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="{DynamicResource BModalWidth}"
                  Background="{DynamicResource BBgElevatedBrush}"
                  BorderBrush="{DynamicResource BBorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource BRadiusLg}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="20,14"
                      BorderBrush="{DynamicResource BBorderBrush}" BorderThickness="0,0,0,1"
                      IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource BTextBrush}" />
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" Margin="20"
                                Foreground="{DynamicResource BTextBrush}" />
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- ── SplitPanel — master/detail with responsive collapse ───────────── -->
  <ControlTheme x:Key="{x:Type c:SplitPanel}" TargetType="c:SplitPanel">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="PART_Grid" ColumnDefinitions="280,Auto,*">
          <ContentControl x:Name="PART_Master" Grid.Column="0"
                          Content="{TemplateBinding Master}" />
          <GridSplitter x:Name="PART_Splitter" Grid.Column="1" Width="4"
                        ResizeDirection="Columns"
                        Background="{DynamicResource BBorderBrush}" />
          <ContentControl x:Name="PART_Detail" Grid.Column="2"
                          Content="{TemplateBinding Detail}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:collapsed /template/ ContentControl#PART_Master">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:collapsed /template/ GridSplitter#PART_Splitter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
