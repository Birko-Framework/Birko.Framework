<!--
  Data-viewer chrome (FEATURE-020 / TASK-772): the small header-toolbar buttons and the tree's node toggle, the XAML
  counterpart of Birko.Web.Components' shared toolbarBtnSheet. Used by JsonDiffViewer; reusable by any viewer card.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── BToolbarButton — a quiet, bordered header action (web .toolbar-btn) ── -->
  <ControlTheme x:Key="BToolbarButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BTextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadiusSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Foreground="{TemplateBinding Foreground}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BBgSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderFocusBrush}" />
    </Style>
  </ControlTheme>

  <!-- ── BToolbarToggle — the same, pressed state shown as the primary tint (web aria-pressed="true") ── -->
  <ControlTheme x:Key="BToolbarToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BTextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource BFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadiusSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Foreground="{TemplateBinding Foreground}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource BBgSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource BColorPrimaryLightBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BColorPrimaryTextBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderFocusBrush}" />
    </Style>
  </ControlTheme>

  <!-- ── BTreeNodeToggle — a chevron with no chrome; open/closed is the glyph, not a pressed look ── -->
  <ControlTheme x:Key="BTreeNodeToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BTextMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="16" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CornerRadius" Value="{DynamicResource BRadiusSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Foreground="{TemplateBinding Foreground}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BBorderFocusBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </ControlTheme>

  <!-- ── BPre / BCodeBlock — b-pre's and b-code-block's counterparts (TASK-822): keyed themes for a
       SelectableTextBlock, applied where wanted (Theme="{StaticResource BPre}"). Not a type theme: that would put
       every SelectableTextBlock in the library, the markdown and JSON viewers included, into a monospace box. -->
  <ControlTheme x:Key="BPre" TargetType="SelectableTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource BFontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource BTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource BTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource BBgSecondaryBrush}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </ControlTheme>

  <ControlTheme x:Key="BCodeBlock" TargetType="SelectableTextBlock" BasedOn="{StaticResource BPre}">
    <Setter Property="Background" Value="{DynamicResource BBgTertiaryBrush}" />
    <Setter Property="Padding" Value="16" />
  </ControlTheme>

</ResourceDictionary>
