<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>561331c2-d3d3-4b01-a56c-733f1f865b6a</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.VersionControl.Git</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GitModels.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GitService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Tools\GitTools.cs" />
  </ItemGroup>
</Project>
