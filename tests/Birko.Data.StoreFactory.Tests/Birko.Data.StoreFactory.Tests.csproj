<Project Sdk="Microsoft.NET.Sdk">

  <!-- TASK-990: the backend-neutral IStoreFactory. One store suite runs offline on InMemory, JSON, XML and SQLite, and on
       MongoDB, Elasticsearch, RavenDB and Cosmos DB when their BIRKO_* variable is set (failed, not skipped, under
       BIRKO_REQUIRE_LIVE). Connection-string parsing and backend choice are checked offline. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
