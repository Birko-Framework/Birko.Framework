    <Compile Include="$(MSBuildThisFileDirectory)InMemoryChannel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)InMemoryProducer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)InMemoryConsumer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)InMemorySubscription.cs" />
  </ItemGroup>
</Project>
