<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>c2d3e4f5-a6b7-4c8d-9e0f-1a2b3c4d5e6f</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Health.Azure</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)AzureBlobHealthCheck.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AzureHealthCheckHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AzureKeyVaultHealthCheck.cs" />
  </ItemGroup>
</Project>
