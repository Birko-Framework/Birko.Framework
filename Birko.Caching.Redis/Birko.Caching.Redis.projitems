<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a1b2c3d4-e5f6-4a7b-8c9d-cac127000002</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Caching.Redis</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: StackExchange.Redis, declared by Birko.Redis.projitems and deliberately
       NOT repeated here. A consumer imports this projitems alongside that one — this project builds
       on Birko.Redis and cannot work without it — so a second declaration lands in the same project
       file and restore reports NU1504, which the -warnaserror that verify-conventions runs turns
       into an error. Import Birko.Redis.projitems to get the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Exceptions\WholeDatabaseDeleteException.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisCache.cs" />
  </ItemGroup>
</Project>
