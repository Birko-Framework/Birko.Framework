<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a1b2c3d4-e5f6-4a7b-8c9d-cac127000002</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Caching.Redis</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: StackExchange.Redis — CONSUMER-SUPPLIED, deliberately not declared here:

         <PackageReference Include="StackExchange.Redis" Version="2.*" />

       See Birko.Redis.projitems for the reasoning. In short: five projitems in this family use the
       driver and Birko.Health.Redis is not a satellite of any of them, so no single project can own
       the declaration without either coupling unrelated projects or emitting a duplicate
       PackageReference wherever two of them are imported together (NU1504) — TASK-234. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Exceptions\WholeDatabaseDeleteException.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisCache.cs" />
  </ItemGroup>
</Project>
