<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>e7a1c3d5-9b2f-4e6a-8c0d-5f3b1a7e9c24</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.EventSourcing.SQL</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Models -->
    <Compile Include="$(MSBuildThisFileDirectory)Models\DomainEventModel.cs" />
    <!-- Core -->
    <Compile Include="$(MSBuildThisFileDirectory)SqlEventStore.cs" />
  </ItemGroup>
</Project>
