<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>b2c3d4e5-f6a7-4b8c-9d0e-1a2b3c4d5e6f</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Rules</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <Compile Include="$(MSBuildThisFileDirectory)Core\ComparisonOperator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\LogicOperator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\RuleSeverity.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\IRule.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\Rule.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\RuleGroup.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\RuleSet.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Core\RuleResult.cs" />
    <!-- Context -->
    <Compile Include="$(MSBuildThisFileDirectory)Context\IRuleContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\DictionaryRuleContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\ObjectRuleContext.cs" />
    <!-- Evaluation -->
    <Compile Include="$(MSBuildThisFileDirectory)Evaluation\IRuleEvaluator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Evaluation\ComparisonHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Evaluation\RuleEvaluator.cs" />
  </ItemGroup>
</Project>
