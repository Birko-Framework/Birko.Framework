<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>b4c5d6e7-f8a9-4b0c-1d2e-3f4a5b6c7d8e</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Localization.Data</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Models -->
    <Compile Include="$(MSBuildThisFileDirectory)Models\TranslationModel.cs" />
    <!-- Filters -->
    <Compile Include="$(MSBuildThisFileDirectory)Filters\TranslationFilter.cs" />
    <!-- Provider -->
    <Compile Include="$(MSBuildThisFileDirectory)DatabaseTranslationProvider.cs" />
  </ItemGroup>
</Project>
