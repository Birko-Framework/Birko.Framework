<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a0b1c2d3-e4f5-4a6b-bc7d-9e0f1a2b3c4d</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Serialization.Protobuf</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Two forms, one dependency. Under Central Package Management a PackageReference must NOT
         carry a Version (NU1008) — the consumer's Directory.Packages.props owns it. Three Birko
         consumers use CPM, so a version-carrying declaration made their solutions unrestorable.
         Conditioning on the well-known $(ManagePackageVersionsCentrally) serves both.

         This project wraps protobuf-net and is its only user in the framework, so it owns the dependency
         outright: a consumer imports this projitems and never learns the package name. Floats within
         the major so a published advisory heals on the next restore (TASK-234). -->
    <PackageReference Include="protobuf-net" Version="3.*" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="protobuf-net" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)ProtobufBinarySerializer.cs" />
  </ItemGroup>
</Project>
