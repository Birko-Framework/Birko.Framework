<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>c4d5e6f7-a8b9-4c0d-9e1f-2a3b4c5d6e72</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.MessageQueue.Mqtt</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Two forms, one dependency. Under Central Package Management a PackageReference must NOT
         carry a Version (NU1008) — the consumer's Directory.Packages.props owns it. Three Birko
         consumers use CPM, so a version-carrying declaration made their solutions unrestorable.
         Conditioning on the well-known $(ManagePackageVersionsCentrally) serves both.

         This project wraps MQTTnet and is its only user in the framework, so it owns the dependency
         outright: a consumer imports this projitems and never learns the package name. Floats within
         the major so a published advisory heals on the next restore (TASK-234). -->
    <PackageReference Include="MQTTnet" Version="4.*" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="MQTTnet" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MqttMessageQueue.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttProducer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttConsumer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttSubscription.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttQualityOfService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttLastWill.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MqttTopic.cs" />
  </ItemGroup>

</Project>
