<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>83a93570-cce7-43b3-b714-b27f13434525</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Security.OAuth.Server.AspNetCore</Import_RootNamespace>
  </PropertyGroup>
  <!-- Framework dependency: Microsoft.AspNetCore.App — CONSUMER-SUPPLIED, exactly as for
       Birko.Security.AspNetCore (TASK-234): a duplicate FrameworkReference is NETSDK1087, a hard error,
       so no Birko projitems declares it. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)OAuthServerEndpointOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OAuthServerEndpointExtensions.cs" />
  </ItemGroup>
</Project>
