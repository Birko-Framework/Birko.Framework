<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a1b2c3d4-e5f6-4a7b-8c9d-ceceb2d20002</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Security.Jwt</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Two forms, one dependency. Under Central Package Management a PackageReference must NOT
         carry a Version (NU1008) — the consumer's Directory.Packages.props owns it. Conditioning on
         the well-known $(ManagePackageVersionsCentrally) serves both.

         This project wraps System.IdentityModel.Tokens.Jwt and owns it. Microsoft.IdentityModel.Tokens
         and Microsoft.IdentityModel.JsonWebTokens arrive with it and are deliberately not declared
         separately.

         Birko.Security.AspNetCore uses Microsoft.IdentityModel.Tokens too, and does not declare it: it
         references Birko.Security.Jwt.JwtTokenProvider, so a consumer imports the two together and a
         second declaration would be NU1504.

         Floats within its major. Three test projects previously pinned three DIFFERENT versions of this
         package — 8.1.2, 8.4.0 and 8.7.0 — which is the drift one owner removes (TASK-234). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)JwtTokenProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenIdConnect\OidcProviderOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenIdConnect\OidcVerificationResult.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenIdConnect\IOidcSigningKeySource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenIdConnect\HttpOidcSigningKeySource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenIdConnect\IOidcIdTokenVerifier.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OpenIdConnect\OidcIdTokenVerifier.cs" />
  </ItemGroup>

</Project>
