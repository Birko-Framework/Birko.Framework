<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>d7a3b1c4-e2f5-4a6b-9c8d-3e1f4a5b6c7d</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.MessageQueue.Redis</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: StackExchange.Redis — CONSUMER-SUPPLIED, deliberately not declared here:

         <PackageReference Include="StackExchange.Redis" Version="2.*" />

       See Birko.Redis.projitems for the reasoning. In short: five projitems in this family use the
       driver and Birko.Health.Redis is not a satellite of any of them, so no single project can own
       the declaration without either coupling unrelated projects or emitting a duplicate
       PackageReference wherever two of them are imported together (NU1504) — TASK-234. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)RedisStreamQueue.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisProducer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisConsumer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisSubscription.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisStreamSettings.cs" />
  </ItemGroup>
</Project>
