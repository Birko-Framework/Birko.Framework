<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>d7a3b1c4-e2f5-4a6b-9c8d-3e1f4a5b6c7d</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.MessageQueue.Redis</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: StackExchange.Redis, declared by Birko.Redis.projitems and deliberately
       NOT repeated here. A consumer imports this projitems alongside that one — this project builds
       on Birko.Redis and cannot work without it — so a second declaration lands in the same project
       file and restore reports NU1504, which the -warnaserror that verify-conventions runs turns
       into an error. Import Birko.Redis.projitems to get the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)RedisStreamQueue.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisProducer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisConsumer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisSubscription.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedisStreamSettings.cs" />
  </ItemGroup>
</Project>
