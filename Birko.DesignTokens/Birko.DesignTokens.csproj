<Project Sdk="Microsoft.NET.Sdk">

  <!-- NOTE: This is a real, buildable console .csproj — the FIRST in the Birko\Framework
       bucket (all shared libs are .shproj/.projitems). Justified: it is a build-time
       code-generation TOOL, not a runtime shared library, so it needs build output.
       See EPIC-015 and this project's CLAUDE.md for the documented convention deviation. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Birko.DesignTokens</RootNamespace>
    <AssemblyName>Birko.DesignTokens</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- tokens.json is the single source of truth; ship it beside the tool so the
         path resolver can anchor on it. It is data, not compiled code. -->
    <None Update="tokens.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Birko.DesignTokens.Tests" />
  </ItemGroup>

</Project>
