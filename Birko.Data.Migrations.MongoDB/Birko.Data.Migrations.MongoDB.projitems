<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{D2E3F4A5-B6C7-4D8E-9F0A-2B3C4D5E6F7A}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.Migrations.MongoDB</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: MongoDB.Driver, declared by Birko.Data.MongoDB.projitems and deliberately
       NOT repeated here. A consumer imports this projitems alongside that one — this project builds on
       the MongoDB store and cannot work without it — so a second declaration lands in the same project
       file and restore reports NU1504, which the -warnaserror that verify-conventions runs turns into
       an error. Import Birko.Data.MongoDB.projitems to get the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MongoMigrationStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MongoMigrationRunner.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Settings\MongoMigrationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\MongoMigrationContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\MongoSchemaBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\MongoDataMigrator.cs" />
  </ItemGroup>
</Project>
