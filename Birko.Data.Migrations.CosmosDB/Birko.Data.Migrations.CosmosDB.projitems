<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{C9D0E1F2-A3B4-4C5D-8E6F-7A8B9C0D1E2F}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.Migrations.CosmosDB</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: Microsoft.Azure.Cosmos, declared by Birko.Data.CosmosDB.projitems and deliberately NOT
       repeated here. A consumer imports this projitems alongside that one — this project builds on the CosmosDB store and cannot work without it — so a
       second declaration lands in the same project file and restore reports NU1504, which the
       -warnaserror that verify-conventions runs turns into an error. Import Birko.Data.CosmosDB.projitems to
       get the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)CosmosMigrationStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)CosmosMigrationRunner.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Settings\CosmosMigrationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\CosmosDBMigrationContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\CosmosDBSchemaBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Context\CosmosDBDataMigrator.cs" />
  </ItemGroup>
</Project>
