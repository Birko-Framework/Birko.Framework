<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>7253bb3a-2715-4cf1-8374-d38d425d1b61</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Birko.Data.MongoDB.Views</Import_RootNamespace>
  </PropertyGroup>
  <!-- External dependency: MongoDB.Driver, declared by Birko.Data.MongoDB.projitems and deliberately
       NOT repeated here. A consumer imports this projitems alongside that one — this project builds on
       the MongoDB store and cannot work without it — so a second declaration lands in the same project
       file and restore reports NU1504, which the -warnaserror that verify-conventions runs turns into
       an error. Import Birko.Data.MongoDB.projitems to get the driver (TASK-234). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MongoViewTranslator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MongoViewSerialization.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MongoViewStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MongoViewManager.cs" />
  </ItemGroup>
</Project>
